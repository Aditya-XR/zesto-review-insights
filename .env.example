# Every variable the app reads. Keys stay empty here; put real ones only in .env (never committed).
# Set ONE of these keys. If several are set, the first in this order wins: Gemini, OpenAI, Groq.
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
# Model for whichever key is set. Leave empty to use that provider's default
# (gemini-2.5-flash / gpt-4o-mini / llama-3.3-70b-versatile).
LLM_MODEL=gemini-2.5-flash
# Optional: override the OpenAI-compatible endpoint (empty = the provider's standard URL).
LLM_BASE_URL=
# Tuning: reviews per LLM call and parallel calls (lower LLM_CONCURRENCY on a strict free tier).
LLM_BATCH_SIZE=25
LLM_CONCURRENCY=3
# Optional, passed to the API as reasoning_effort (e.g. "low"/"none" makes Gemini 2.5 faster).
LLM_REASONING_EFFORT=
# Host ports (the defaults are fine)
API_PORT=8000
WEB_PORT=3000
